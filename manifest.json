{
  "manifest_version": 3,
  "name": "Time Alert",
  "version": "1.0.0",
  "description": "タイマーとアラーム機能をサイドパネルで提供するChrome拡張機能。",
  "permissions": [
    "sidePanel",
    "storage",
    "alarms",
    "notifications",
    "offscreen"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "sidepanel/sidepanel.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "css": ["content_scripts/content.css"],
      "js": ["content_scripts/content.js"]
    }
  ],
  "action": {
    "default_title": "Time Alert"
  },
  "options_page": "settings/settings.html",
  "options_ui": {
    "page": "settings/settings.html",
    "open_in_tab": true
  },
  "web_accessible_resources": [
    {
      "resources": [
        "sounds/*",
        "icons/*"
      ],
      "matches": ["<all_urls>"]
    }
  ],
  "icons": {
    "16": "icons/icon.png",
    "48": "icons/icon.png",
    "128": "icons/icon.png"
  }
}
